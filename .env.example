# Copy to .env (or export these) before starting the backend.
# On Colab the notebook sets these for you.

# ---- server ----
OG_HOST=0.0.0.0
OG_PORT=7860

# Shared secret. If set, every API call must send X-Auth-Token: <value>
# (the web UI asks for it once and remembers it). ALWAYS set this when you
# expose the app through a public tunnel.
OG_TOKEN=

# Comma separated list of allowed browser origins, or "*" for any.
OG_CORS=*

# ---- storage ----
# Where uploads / renders / job metadata live.
OG_DATA_DIR=

# Keep at most this many finished jobs on disk.
OG_KEEP_JOBS=40

# Max upload size per file, in megabytes.
OG_MAX_UPLOAD_MB=512

# ---- inference engine (ComfyUI) ----
# Base URL of the ComfyUI server the backend drives.
OG_COMFY_URL=http://127.0.0.1:8188

# Path to ComfyUI's "input" directory. When backend and ComfyUI run on the
# same machine this is used instead of HTTP uploads (much faster for videos).
OG_COMFY_INPUT_DIR=

# auto | mock | wan21-vace | wan22-animate | wan22-animate-gguf
OG_ENGINE=auto

# Set to 1 to skip the manifest VRAM gate and attempt a too-large model anyway
# (ComfyUI will offload to system RAM; expect it to be slow or to OOM).
OG_IGNORE_VRAM=0

# ---- ffmpeg (optional overrides) ----
OG_FFMPEG=
OG_FFPROBE=
