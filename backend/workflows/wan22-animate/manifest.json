{
  "id": "wan22-animate",
  "label": "Wan 2.2 Animate 14B",
  "priority": 30,
  "maturity": "experimental",
  "description": "Wan 2.2 Animate Mix replacement pipeline: SAM2 removes the source performer, and pose plus face guidance transfers the driving motion into the uploaded character. Highest fidelity, heaviest on VRAM.",
  "notes": "Needs ~10 GB upload + ComfyUI lowvram. Expect 12-25 min for a 4 s 480p clip on a free T4. If preflight reports missing nodes, either update ComfyUI or use the wan21-vace engine.",
  "defaults": {
    "width": 832,
    "height": 480,
    "fps": 16,
    "frames": 65,
    "steps": 8,
    "cfg": 1.0,
    "shift": 8.0
  },
  "max_seconds": 30,
  "min_vram_mb": 22000,
  "required_nodes": [
    "LoadImage",
    "LoadVideo",
    "GetVideoComponents",
    "OnnxDetectionModelLoader",
    "PoseAndFaceDetection",
    "DrawViTPose",
    "DownloadAndLoadSAM2Model",
    "Sam2Segmentation",
    "GrowMaskWithBlur",
    "BlockifyMask",
    "DrawMaskOnImage",
    "TrimVideoLatent",
    "CLIPLoader",
    "VAELoader",
    "CLIPVisionLoader",
    "CLIPVisionEncode",
    "UNETLoader",
    "CLIPTextEncode",
    "KSampler",
    "VAEDecode",
    "CreateVideo",
    "SaveVideo",
    "WanAnimateToVideo"
  ],
  "replacement_mode": "sam2_mix",
  "required_models": [
    "diffusion_models/Wan2_2-Animate-14B_fp8_scaled_e4m3fn_KJ_v2.safetensors",
    "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
    "vae/wan_2.1_vae.safetensors",
    "clip_vision/clip_vision_h.safetensors",
    "detection/yolov10m.onnx",
    "detection/vitpose-l-wholebody.onnx",
    "sam2/sam2_hiera_base_plus.safetensors"
  ],
  "speed_modes": {
    "lightning": {
      "label": "Lightning (4-8 steps, no CFG)",
      "steps": 6,
      "cfg": 1.0,
      "lora": "wan2.2_animate_14B_lightning.safetensors"
    }
  }
}
