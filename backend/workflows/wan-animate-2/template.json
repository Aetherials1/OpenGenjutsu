{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "@char"
    },
    "_meta": { "title": "Character reference" }
  },
  "2": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "@motion"
    },
    "_meta": { "title": "Motion source" }
  },
  "2b": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["2", 0]
    },
    "_meta": { "title": "Extract motion frames" }
  },
  "20": {
    "class_type": "OnnxDetectionModelLoader",
    "inputs": {
      "vitpose_model": "vitpose-l-wholebody.onnx",
      "yolo_model": "yolov10m.onnx",
      "onnx_device": "CUDAExecutionProvider"
    },
    "_meta": { "title": "Wan Animate pose/face detector" }
  },
  "21": {
    "class_type": "PoseAndFaceDetection",
    "inputs": {
      "model": ["20", 0],
      "images": ["2b", 0],
      "width": "@width",
      "height": "@height",
      "retarget_image": ["1", 0],
      "face_padding": 16
    },
    "_meta": { "title": "Extract face crops and retargeted pose" }
  },
  "22": {
    "class_type": "DrawViTPose",
    "inputs": {
      "pose_data": ["21", 0],
      "width": "@width",
      "height": "@height",
      "body_stick_width": -1,
      "hand_stick_width": -1,
      "draw_head": true
    },
    "_meta": { "title": "Render pose guidance" }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "_meta": { "title": "Text encoder (umt5-xxl)" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "_meta": { "title": "VAE" }
  },
  "5": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    },
    "_meta": { "title": "CLIP vision" }
  },
  "6": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["5", 0],
      "image": ["1", 0],
      "crop": "center"
    },
    "_meta": { "title": "Encode reference image" }
  },
  "7": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan_animate_2_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Wan Animate 2 (14B DiT)" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@prompt",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Positive prompt" }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@negative",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "10": {
    "class_type": "WanAnimate2ToVideo",
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "vae": ["4", 0],
      "reference_image": ["1", 0],
      "pose_video": ["22", 0],
      "clip_vision_output": ["6", 0],
      "width": "@width",
      "height": "@height",
      "length": "@frames",
      "batch_size": 1,
      "video_frame_offset": 0,
      "pose_strength": 1.0
    },
    "_meta": { "title": "Wan Animate 2 conditioning" }
  },
  "11": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["7", 0],
      "shift": "@shift"
    },
    "_meta": { "title": "Sampling shift" }
  },
  "12": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["11", 0],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": "@cfg",
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["10", 0],
      "negative": ["10", 1],
      "latent_image": ["10", 2],
      "denoise": 1.0
    },
    "_meta": { "title": "Sampler" }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "Decode" }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["13", 0],
      "fps": "@fps"
    },
    "_meta": { "title": "Assemble video" }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "@prefix",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": { "title": "Save" }
  }
}
