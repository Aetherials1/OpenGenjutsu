{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "@char",
      "upload": "image"
    },
    "_meta": { "title": "Character reference" }
  },
  "2": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "@motion",
      "frame_load_cap": "@frames",
      "skip_first_frames": 0,
      "select_every_nth": 1
    },
    "_meta": { "title": "Motion source" }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "_meta": { "title": "Text encoder (umt5-xxl)" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "_meta": { "title": "VAE" }
  },
  "5": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_vace_1.3B_fp16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Wan 2.1 VACE 1.3B" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@prompt",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Positive prompt" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@negative",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "8": {
    "class_type": "WanVaceToVideo",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["4", 0],
      "width": "@width",
      "height": "@height",
      "length": "@frames",
      "batch_size": 1,
      "strength": 1.0,
      "control_video": ["2", 0],
      "reference_image": ["1", 0]
    },
    "_meta": { "title": "VACE conditioning" }
  },
  "9": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["5", 0],
      "shift": "@shift"
    },
    "_meta": { "title": "Sampling shift" }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["9", 0],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": "@cfg",
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["8", 2],
      "denoise": 1.0
    },
    "_meta": { "title": "Sampler" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "Decode" }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "fps": "@fps"
    },
    "_meta": { "title": "Assemble video" }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "@prefix",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": { "title": "Save" }
  }
}
