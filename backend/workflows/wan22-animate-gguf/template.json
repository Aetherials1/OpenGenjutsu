{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "@char"
    },
    "_meta": { "title": "Character reference" }
  },
  "2": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "@motion"
    },
    "_meta": { "title": "Motion source" }
  },
  "2b": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["2", 0]
    },
    "_meta": { "title": "Extract motion frames" }
  },
  "20": {
    "class_type": "OnnxDetectionModelLoader",
    "inputs": {
      "vitpose_model": "vitpose-l-wholebody.onnx",
      "yolo_model": "yolov10m.onnx",
      "onnx_device": "CUDAExecutionProvider"
    },
    "_meta": { "title": "Wan Animate pose/face detector" }
  },
  "21": {
    "class_type": "PoseAndFaceDetection",
    "inputs": {
      "model": ["20", 0],
      "images": ["2b", 0],
      "width": "@width",
      "height": "@height",
      "retarget_image": ["1", 0],
      "face_padding": 16
    },
    "_meta": { "title": "Extract face crops and retargeted pose" }
  },
  "22": {
    "class_type": "DrawViTPose",
    "inputs": {
      "pose_data": ["21", 0],
      "width": "@width",
      "height": "@height",
      "retarget_padding": 16,
      "body_stick_width": -1,
      "hand_stick_width": -1,
      "draw_head": true
    },
    "_meta": { "title": "Render pose guidance" }
  },
  "23": {
    "class_type": "DownloadAndLoadSAM2Model",
    "inputs": {
      "model": "sam2.1_hiera_base_plus.safetensors",
      "segmentor": "video",
      "device": "cuda",
      "precision": "fp16"
    },
    "_meta": { "title": "Load SAM2 video segmenter" }
  },
  "24": {
    "class_type": "Sam2Segmentation",
    "inputs": {
      "sam2_model": ["23", 0],
      "image": ["2b", 0],
      "keep_model_loaded": false,
      "bboxes": ["21", 3]
    },
    "_meta": { "title": "Track source performer mask" }
  },
  "25": {
    "class_type": "GrowMaskWithBlur",
    "inputs": {
      "mask": ["24", 0],
      "expand": 10,
      "incremental_expandrate": 0.0,
      "tapered_corners": true,
      "flip_input": false,
      "blur_radius": 0.0,
      "lerp_alpha": 1.0,
      "decay_factor": 1.0,
      "fill_holes": false
    },
    "_meta": { "title": "Grow performer mask" }
  },
  "26": {
    "class_type": "BlockifyMask",
    "inputs": {
      "masks": ["25", 0],
      "block_size": 32
    },
    "_meta": { "title": "Align mask to Wan latent blocks" }
  },
  "27": {
    "class_type": "DrawMaskOnImage",
    "inputs": {
      "image": ["2b", 0],
      "mask": ["26", 0],
      "color": "0, 0, 0"
    },
    "_meta": { "title": "Black out source performer" }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "_meta": { "title": "Text encoder (umt5-xxl)" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "_meta": { "title": "VAE" }
  },
  "5": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    },
    "_meta": { "title": "CLIP vision" }
  },
  "5b": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": ["5", 0],
      "image": ["1", 0],
      "crop": "center"
    },
    "_meta": { "title": "Encode reference image" }
  },
  "6": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "Wan2.2-Animate-14B-Q4_K_M.gguf"
    },
    "_meta": { "title": "Wan 2.2 Animate 14B (GGUF Q4_K_M)" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@prompt",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Positive prompt" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@negative",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "9": {
    "class_type": "WanAnimateToVideo",
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["4", 0],
      "width": "@width",
      "height": "@height",
      "length": "@frames",
      "batch_size": 1,
      "clip_vision_output": ["5b", 0],
      "reference_image": ["1", 0],
      "pose_video": ["22", 0],
      "face_video": ["21", 1],
      "background_video": ["27", 0],
      "character_mask": ["26", 0],
      "continue_motion_max_frames": 1,
      "video_frame_offset": 0
    },
    "_meta": { "title": "Wan Animate conditioning" }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["6", 0],
      "shift": "@shift"
    },
    "_meta": { "title": "Sampling shift" }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": "@cfg",
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "denoise": 1.0
    },
    "_meta": { "title": "Sampler" }
  },
  "12": {
    "class_type": "TrimVideoLatent",
    "inputs": {
      "samples": ["11", 0],
      "trim_amount": ["9", 3]
    },
    "_meta": { "title": "Trim conditioning frames" }
  },
  "12b": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "Decode" }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12b", 0],
      "fps": "@fps"
    },
    "_meta": { "title": "Assemble video" }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "@prefix",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": { "title": "Save" }
  }
}
