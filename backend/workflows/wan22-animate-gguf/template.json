    "_meta": { "title": "Wan 2.2 Animate 14B (GGUF Q4_K_M)" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@prompt",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Positive prompt" }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "@negative",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "9": {
    "class_type": "WanAnimateToVideo",
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["4", 0],
      "width": "@width",
      "height": "@height",
      "length": "@frames",
      "batch_size": 1,
      "clip_vision_output": ["5b", 0],
      "reference_image": ["1", 0],
      "pose_video": ["2b", 0],
      "face_video": ["2b", 0],
      "continue_motion_max_frames": 1,
      "video_frame_offset": 0
    },
    "_meta": { "title": "Wan Animate conditioning" }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["6", 0],
      "shift": "@shift"
    },
    "_meta": { "title": "Sampling shift" }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": "@cfg",
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "denoise": 1.0
    },
    "_meta": { "title": "Sampler" }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "Decode" }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12", 0],
      "fps": "@fps"
    },
    "_meta": { "title": "Assemble video" }
