{
  "id": "wan22-animate-gguf",
  "label": "Wan 2.2 Animate 14B (GGUF Q4)",
  "priority": 10,
  "maturity": "experimental",
  "description": "Wan 2.2 Animate Mix replacement pipeline: SAM2 tracks and removes the source performer, while pose and face guidance drive the uploaded character. The diffusion model is 4-bit quantised (GGUF) so it fits a 16 GB free Colab T4.",
  "notes": "Fits ~16 GB VRAM with --lowvram. Slower per step than fp8 but the only way to run Animate on a T4. Install with: python scripts/colab_setup.py comfy --with-gguf, then python scripts/colab_setup.py models --preset animate-q4.",
  "defaults": {
    "width": 832,
    "height": 480,
    "fps": 16,
    "model_fps": 16,
    "output_fps": 60,
    "frames": 65,
    "steps": 8,
    "cfg": 1.0,
    "shift": 8.0
  },
  "max_seconds": 30,
  "min_vram_mb": 14000,
  "required_nodes": [
    "LoadImage",
    "LoadVideo",
    "GetVideoComponents",
    "OnnxDetectionModelLoader",
    "PoseAndFaceDetection",
    "DrawViTPose",
    "DownloadAndLoadSAM2Model",
    "Sam2Segmentation",
    "GrowMaskWithBlur",
    "BlockifyMask",
    "DrawMaskOnImage",
    "TrimVideoLatent",
    "CLIPLoader",
    "VAELoader",
    "CLIPVisionLoader",
    "CLIPVisionEncode",
    "UnetLoaderGGUF",
    "CLIPTextEncode",
    "KSampler",
    "VAEDecode",
    "CreateVideo",
    "SaveVideo",
    "WanAnimateToVideo"
  ],
  "required_models": [
    "diffusion_models/Wan2.2-Animate-14B-Q4_K_M.gguf",
    "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
    "vae/wan_2.1_vae.safetensors",
    "clip_vision/clip_vision_h.safetensors",
    "detection/yolov10m.onnx",
    "detection/vitpose-l-wholebody.onnx",
    "sam2/sam2.1_hiera_base_plus-fp16.safetensors"
  ],
  "replacement_mode": "sam2_mix",
  "speed_modes": {}
}
